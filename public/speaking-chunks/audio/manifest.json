      "sha256": "9419e906f15f91e4d325a916d3d78f2678b7232a8e521a17b6c95694c251034e"
    },
    {
      "id": "frame-complement-bei-1",
      "text": "我的杯子被小猫碰倒了。",
      "file": "frame-complement-bei-1.mp3",
      "sha256": "73d828dc855dbfe28717201ae03298271bee9a77f635e480ecd0b70ec59f12d8"
    },
