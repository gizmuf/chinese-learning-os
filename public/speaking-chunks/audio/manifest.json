      "sha256": "a3dd4d18a4c72fb263a1b72ea1899c9a63cb7a01f458bf29fa9725e4e2a6eeb5"
    },
    {
      "id": "frame-complement-ba-1-1",
      "text": "把",
      "file": "frame-complement-ba-1-1.mp3",
      "sha256": "ae8efe780f34141f6eef3aa31adb366def32400554efd68a4dbbb1f4e0ce5e45"
    },
    {
      "id": "frame-complement-ba-2",
      "text": "我把作业写完了。",
      "file": "frame-complement-ba-2.mp3",
      "sha256": "0d6ea9a145cee9f43bf2c46fd1b9865fc2aae249217d51fe3f62364d74fb14b2"
    },
    {
      "id": "frame-complement-ba-2-1",
      "text": "把",
