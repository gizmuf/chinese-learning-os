      "sha256": "ae8efe780f34141f6eef3aa31adb366def32400554efd68a4dbbb1f4e0ce5e45"
    },
    {
      "id": "frame-complement-ba-1",
      "text": "请把杯子放在桌子上。",
      "file": "frame-complement-ba-1.mp3",
      "sha256": "e0dc8179f99e0d5e679e080a72f0a851f6700d091405ec0773a86a89ac88de1e"
