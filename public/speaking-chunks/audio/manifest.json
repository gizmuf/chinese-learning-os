      "sha256": "60f3ad750d59932fc6f1fafca9a8b518499172764bf238fce7e10230318d02a5"
    },
    {
      "id": "frame-complement-de-2",
      "text": "她跑得很快。",
      "file": "frame-complement-de-2.mp3",
      "sha256": "1b1fce7c5f6abf905232205df7b5d1fae34f408bd5370dcbefd46c99fdb9fc4e"
    },
    {
      "id": "frame-time-as-soon-1-1",
      "text": "一",
