      "sha256": "9419e906f15f91e4d325a916d3d78f2678b7232a8e521a17b6c95694c251034e"
    },
    {
      "id": "frame-aspect-experience-1",
      "text": "我去过杭州。",
      "file": "frame-aspect-experience-1.mp3",
      "sha256": "ad7ef3c99244e85afc811eca43b3032bd87fd8db30aef20b6cbe3f032551e8aa"
    },
    {
      "id": "frame-aspect-experience-1-1",
      "text": "过",
      "file": "frame-aspect-experience-1-1.mp3",
      "sha256": "60f3ad750d59932fc6f1fafca9a8b518499172764bf238fce7e10230318d02a5"
    },
    {
      "id": "frame-aspect-experience-2",
      "text": "你吃过这种面条吗？",
      "file": "frame-aspect-experience-2.mp3",
      "sha256": "173ab5715bff980ae1f10edb9bb08c215aad197427d5834414d9fccb38632fbd"
    },
    {
      "id": "frame-aspect-experience-2-1",
      "text": "过",
