      "sha256": "5195558d38c671aa4c6dc365aad09655c1c9e18f6f856415fbc8cb44e6ff9455"
    },
    {
      "id": "frame-time-as-soon-2",
      "text": "他一听到音乐就开始跳舞。",
      "file": "frame-time-as-soon-2.mp3",
      "sha256": "9caf6d385ec43aa4802e904bd4ca620a29ebfe99ef6806f34a9f4eae626ed14f"
    },
    {
      "id": "frame-time-as-soon-2-1",
      "text": "一",
      "file": "frame-time-as-soon-2-1.mp3",
      "sha256": "3a3841e33e0388b65fe1b2e59e4ec2f05fdabcfeb15086e7e4127354b7c1dc9e"
    },
    {
      "id": "frame-time-as-soon-2-3",
      "text": "就",
      "file": "frame-time-as-soon-2-3.mp3",
      "sha256": "5195558d38c671aa4c6dc365aad09655c1c9e18f6f856415fbc8cb44e6ff9455"
    },
    {
      "id": "frame-complement-bei-2",
      "text": "那块蛋糕被弟弟吃掉了。",
      "file": "frame-complement-bei-2.mp3",
      "sha256": "789ae9b03e5a757eb856a48cefed204b5a3f9bfdb16b33fec4230e76ac767765"
    },
    {
      "id": "frame-time-as-soon-1",
      "text": "我一到家就给你打电话。",
      "file": "frame-time-as-soon-1.mp3",
