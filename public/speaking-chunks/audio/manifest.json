      "sha256": "0d334bc0fd70ff6bbe0d5a97f0eeba3945617a276e87876c47eef50a1b99767d"
    },
    {
      "id": "frame-attitude-interest-2",
      "text": "她对这个活动不感兴趣。",
      "file": "frame-attitude-interest-2.mp3",
      "sha256": "48c0e77ea80112221cd432a8c99dc266a3e88f464092481b204d866887757221"
    },
    {
      "id": "frame-attitude-interest-2-1",
      "text": "对",
      "file": "frame-attitude-interest-2-1.mp3",
      "sha256": "371d1104f42c85a3e7939bae935722a3946c747b4fe3ecee20caeae672a81019"
    },
    {
      "id": "frame-attitude-interest-2-4",
      "text": "感兴趣",
      "file": "frame-attitude-interest-2-4.mp3",
      "sha256": "0d334bc0fd70ff6bbe0d5a97f0eeba3945617a276e87876c47eef50a1b99767d"
    },
    {
      "id": "frame-attitude-interest-1",
      "text": "我对中国历史很感兴趣。",
