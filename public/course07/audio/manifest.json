      "sha256": "196146152649d59f1a48daa84103cca8d0a042122b3df6c36416e877c2ed2df0"
    },
    {
      "id": "c07-s50",
      "text": "我们去人民公园吧。",
      "file": "c07-s50.mp3",
      "sha256": "672ccc9eb0dc41bf70252597423702226d4f92c835b196a5891afcb5a9c90227"
