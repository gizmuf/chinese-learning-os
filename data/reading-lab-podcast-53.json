  "grammar": [
    {
      "id": "as-soon-as",
      "pattern": "一……就……",
      "note": "Use 一 and 就 to connect an event with what happens immediately after it.",
      "example": {
        "hanzi": "我一到家就给你打电话。",
        "pinyin": "Wǒ yī dào jiā jiù gěi nǐ dǎ diànhuà.",
        "english": "I will call you as soon as I get home."
      },
      "sourceChunks": [
        "p1-c1"
      ]
    },
    {
      "id": "first-then",
      "pattern": "先……再……",
      "note": "Use 先 for the first action and 再 for the action that follows.",
      "example": {
        "hanzi": "我们先买菜，再回家做饭。",
        "pinyin": "Wǒmen xiān mǎi cài, zài huí jiā zuòfàn.",
        "english": "We will buy groceries first, then go home to cook."
      },
      "sourceChunks": [
        "p3-c3"
      ]
    },
    {
      "id": "as-long-as",
      "pattern": "只要……就……",
      "note": "Use 只要 to give a sufficient condition and 就 to introduce the result.",
      "example": {
        "hanzi": "只要今天不下雨，我们就去公园。",
        "pinyin": "Zhǐyào jīntiān bù xiàyǔ, wǒmen jiù qù gōngyuán.",
        "english": "As long as it does not rain today, we will go to the park."
      },
