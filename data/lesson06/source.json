    },
    {
      "hanzi": "你想要温水还是冰水？",
      "pinyin": "Nǐ xiǎng yào wēnshuǐ háishi bīngshuǐ?",
      "meaning": {
        "en": "Would you like warm water or ice water?",
        "fr": "Tu préfères de l’eau tiède ou glacée ?",
        "ru": "Ты хочешь тёплую или ледяную воду?",
        "tr": "Ilık su mu, buzlu su mu istersin?"
      },
      "id": "waterchoice"
    },
    {
      "hanzi": "你的家乡冷吗？",
