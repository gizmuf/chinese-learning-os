    "pinyin": "yì qiān qī bǎi"
  },
  "c11-s001": {
    "text": "今天几月几号星期几？",
    "source": "/api/practice-recording?file=df59a4876759a6fc3cfb77f119901e11295f0e66bd4f789b5d5fd714fd4b1982",
    "sha256": "279b55d7509e2eafaddb10f4b9e013d7f505dced22240efdead085742e07551c",
    "pinyin": "Jīntiān jǐ yuè jǐ hào xīngqī jǐ?"
  },
  "c11-s002": {
    "text": "今天是十一月三号，星期二。",
    "source": "/api/practice-recording?file=f61531934aeea81a3897ad83b9746a1d0faa83f9c1046003ba1ddb4d53354f80",
    "sha256": "a1c5c852168c384c96a3391c18d6789144d7989f077efbc10dd04831c6588565",
    "pinyin": "Jīntiān shì shíyī yuè sān hào, xīngqī èr."
  },
  "c11-s003": {
    "text": "一周有七天。",
    "source": "/api/practice-recording?file=3e40ff373ec556523b44da52b5061d551d829eb9e35f0d42c8d5bd3e72dd741c",
    "sha256": "a62495ace9bba22be08b5dab074e0d68e5a76974accfff0badcabb869d183c72",
    "pinyin": "Yì zhōu yǒu qī tiān."
  },
  "c11-s004": {
    "text": "一年有四个季节。",
    "source": "/api/practice-recording?file=f82a96a7358037e5d8398d4932db80f32ba1bebfb2b4179932b08faba9d0de1a",
    "sha256": "a201933bfc2f62044d60ed80884fa0f7173f6222c15a649d8fd6f84f0360a723",
    "pinyin": "Yì nián yǒu sì ge jìjié."
  },
  "c11-s005": {
    "text": "二零二六年有三百六十五天。",
    "source": "/api/practice-recording?file=ecc31657a5d40e8bd68046cfa4eb4fc107f61c690791e9d7e7c371adce884bf1",
    "sha256": "c9935f7ae6a363d02a85c75fb84de4be274f0bd6a4f1b73658bdab894dfaec7c",
    "pinyin": "Èr líng èr liù nián yǒu sānbǎi liùshíwǔ tiān."
  },
  "c11-s006": {
    "text": "这是第八课。",
    "source": "/api/practice-recording?file=cff73f74fa17492df931b74fd4cbf4ec5503171cc77ecad88c0e9f8cc7716afe",
    "sha256": "f91e91a76cc277377b6e0554db6b95d250e29c3b12a95c0eb3a06cab688263a6",
    "pinyin": "Zhè shì dì bā kè."
  },
  "c11-s007": {
    "text": "他是我弟弟。",
    "source": "/api/practice-recording?file=26203ae97160383284d9c64d638df005945aad76e772ef49d92b883efa83c9fa",
    "sha256": "13d47b91d9778776eb47e261f65080ad270562d356d56c28161ee2baab081649",
    "pinyin": "Tā shì wǒ dìdi."
  },
  "c11-s008": {
    "text": "现在是什么课？",
    "source": "/api/practice-recording?file=b0b97a4cd97f1d56ddf51927d22df79f5f6dec7749ce179d71c1e45f34e8e5ca",
    "sha256": "3d6ed5195c893e02e5e6c54cb82a3bcf38dced062ecd376014da58bee2c5b298",
    "pinyin": "Xiànzài shì shénme kè?"
  },
  "c11-s009": {
    "text": "现在是什么季节？",
    "source": "/api/practice-recording?file=d7417424c12c0a26b4afafa294098e2f0462b702918c63454385fcf6bdbd049b",
    "sha256": "9fa512e37ebc769e62634c32c7820293629f1e2a7b66b9aa2e6b46e325c2c6e2",
    "pinyin": "Xiànzài shì shénme jìjié?"
  },
  "c11-s010": {
    "text": "现在是秋天。",
    "source": "/api/practice-recording?file=96374b6605d73ba7cd9366ba20228e5700ecbd70e56483d2df3c4a6d449addec",
    "sha256": "c62bcea56c190b720e5cf453293ec8e45f20c4cce35a48ae7cc1d773a352a572",
    "pinyin": "Xiànzài shì qiūtiān."
  },
  "c11-s011": {
    "text": "春天暖，夏天热，秋天凉，冬天冷。",
    "source": "/api/practice-recording?file=58a1f357eea42b011adc325a380d65e345ea00fbd18925307f6b09c34d905c1f",
    "sha256": "82214f9894be5acd817399e3791f6fd68e3bb8f81af331a709e681296a319eb8",
    "pinyin": "Chūntiān nuǎn, xiàtiān rè, qiūtiān liáng, dōngtiān lěng."
  },
  "c11-s012": {
    "text": "冷吗？",
    "source": "/api/practice-recording?file=ca98343349a651d4d3848e2d319c3edabdbe712e8326e6bc62ca771ff20ed518",
    "sha256": "5095286a224d5906038f1adeea36d301eb99c98e2c16974ac61119844a7393bb",
    "pinyin": "Lěng ma?"
  },
  "c11-s013": {
    "text": "很冷。",
    "source": "/api/practice-recording?file=cb48a4445ddf3283dcf89a899616942a0a8c25abbc7a2a5148672f86af7c6a0b",
    "sha256": "29e7e84f7d6167c7f0fdd0c0266dd0f1b55960f7a1b2868aae67fc87328267b8",
    "pinyin": "Hěn lěng."
  },
  "c11-s014": {
    "text": "不冷不热。",
    "source": "/api/practice-recording?file=ab8da1827dd5393d6e5b46f8a0e539aa790b8033d8440b92de03edab74f51780",
    "sha256": "d38415b811127679499a3ec102aea0e5bba58da37f718d743da000e4069a9a45",
    "pinyin": "Bù lěng bú rè."
  },
  "c11-s015": {
    "text": "有点儿冷。",
    "source": "/api/practice-recording?file=5197b9ff8534edfb59dcbffe5b00d84235364b3be9ba32ccb42082c4a385b19d",
    "sha256": "b4e0046628c135445a5522e22af1e6b416c0976a3912d0276e3c7fdb092d004a",
    "pinyin": "Yǒudiǎnr lěng."
  },
  "c11-s016": {
    "text": "今天比昨天冷。",
    "source": "/api/practice-recording?file=d32608900d8c13bbb9f94b776e3e02e05de17f88a4af9397cf372863fba35045",
    "sha256": "8e7fd0ce59da2e0e41c94f01aa374709593e7fe99e3862d55aea5abf50b9a32a",
    "pinyin": "Jīntiān bǐ zuótiān lěng."
  },
  "c11-s017": {
    "text": "今天有点儿冷。",
    "source": "/audio/hsk1-265-sentence.mp3",
    "sha256": "00af47ed93b00778b959238f3b431e802f548b532b48eb2d3a65c97479e07225",
    "pinyin": "Jīntiān yǒudiǎnr lěng."
  },
  "c11-s018": {
    "text": "今天比昨天冷一点儿。",
    "source": "/api/practice-recording?file=23effa9592e5b8739c0da13c744dcef8bc6e16f1d4f8ad735efa4321d282d33f",
    "sha256": "9c2c463547a4058c869e3ca4401ea8a9b159abb2fde42a3b8e032f9d415031f3",
    "pinyin": "Jīntiān bǐ zuótiān lěng yìdiǎnr."
  },
  "c11-s019": {
    "text": "你怎么来学校？",
    "source": "/api/practice-recording?file=30316f11e5f3f622eef0a795dc38f96668ca378aff8e599c71b6461a97376c11",
    "sha256": "a2457c6e8d6b02716149c4849dc74ef990f5816138a9fd9ed0f3af5f30c1e6e5",
    "pinyin": "Nǐ zěnme lái xuéxiào?"
  },
  "c11-s020": {
    "text": "我坐公共汽车。",
    "source": "/api/practice-recording?file=11dfa33b6d42de23fab17e9ab873ff2110f7a7565b86e6de6ba10cfae954fb7d",
    "sha256": "439ab84701bae8bdcbc01835c79a7b11b226d08b8d0cbe8bceac1b56c508ca66",
    "pinyin": "Wǒ zuò gōnggòng qìchē."
  },
  "c11-s021": {
    "text": "我坐地铁来学校。",
    "source": "/api/practice-recording?file=d27b82434c02e8e8720f06aed1c22b6ad5b76165dd0a344dae43c4e946430c00",
    "sha256": "17db26525dbd0bbbaac858b36ff5dbf68bbf3b69fde7ab63c12878268be4ac57",
    "pinyin": "Wǒ zuò dìtiě lái xuéxiào."
  },
  "c11-s022": {
    "text": "我骑自行车来学校。",
    "source": "/api/practice-recording?file=059c384f57bee802e8040e8b369cbf6f6fcdfa4c5da5b386b92f6647951ed648",
    "sha256": "f74586e9dad6f8bfb8fce571d7d18681c9d54e2eb51b7bcbf7ba02e7384b7152",
    "pinyin": "Wǒ qí zìxíngchē lái xuéxiào."
  },
  "c11-s023": {
    "text": "我走路来学校。",
    "source": "/api/practice-recording?file=4f16169bac6636713fc58dff839a725aaacf3c154e62809410560f0cf4b67e59",
    "sha256": "1836f2b0e50fd2f777500e5bbce870948805e5c9703a4aa09314268ef9237f45",
    "pinyin": "Wǒ zǒulù lái xuéxiào."
  },
  "c11-s024": {
    "text": "我开车来学校。",
    "source": "/api/practice-recording?file=465e46bdca4ba8ec667cb7a731e3088cf14925ba4e93c35b6cf57ec836efd4d6",
    "sha256": "c5a91223e48ab8f6d7052dad8b27233983d299b77bb97dc970dc29d1ecc183c6",
    "pinyin": "Wǒ kāichē lái xuéxiào."
  },
  "c11-s025": {
    "text": "我坐出租车来学校。",
    "source": "/api/practice-recording?file=32cebb7cbad3782a0a5a765c5c84e5cb89f25ee0d69baa3f9c90e2bf2d1ac994",
    "sha256": "1b64bda2bb7590ecd795c3dddd9d134e67b63b4494752b3c95bfe68c161a2e67",
    "pinyin": "Wǒ zuò chūzūchē lái xuéxiào."
  },
  "c11-s026": {
    "text": "我骑电动车来学校。",
    "source": "/api/practice-recording?file=ca5615db5a74e09cbddf8b27640bdfef482244bc29476027c46601260f20c83c",
    "sha256": "a41861ad72037a7c0c16145fb393e08bb384aee60af228da7ec9f77332832101",
    "pinyin": "Wǒ qí diàndòngchē lái xuéxiào."
  },
  "c11-s027": {
    "text": "我坐高铁去。",
    "source": "/api/practice-recording?file=e9d5ca940d12d5fb0cd4d2aa419870d779225edaa211be3a37458620b86885ed",
    "sha256": "08ff0959f597c1219fa12b588f2096b9c89c05940e5c13999d0df1308ec24de4",
    "pinyin": "Wǒ zuò gāotiě qù."
  },
  "c11-s028": {
    "text": "六点起床。",
    "source": "/api/practice-recording?file=9a15909d43f4e6ce3e82becb1b0393898e4d72a00864f79815e870b54570f260",
    "sha256": "7095386725b818b20ccb4c5ff099281984a1c6914beeab82c15db268df40a5c2",
    "pinyin": "Liù diǎn qǐchuáng."
  },
  "c11-s029": {
    "text": "你几点吃早饭？",
    "source": "/api/practice-recording?file=6a3e4f1dddff9f3a03156210c195de882265219a3ab021e01176e01e605ddb24",
    "sha256": "a5242d9778eb86518c5aba6b5cf61ac5fc5a662a96b2c459f69b3f1b0e752355",
    "pinyin": "Nǐ jǐ diǎn chī zǎofàn?"
  },
  "c11-s030": {
    "text": "你什么时候吃早饭？",
    "source": "/api/practice-recording?file=90a99257783ab43751fe221a84ff2a8886414ba24ef54e460c2d340734d27ac4",
    "sha256": "d00f680bcc7a781261c9cded90cd85ef9c726761a757b22d8345b373fdbc844e",
    "pinyin": "Nǐ shénme shíhou chī zǎofàn?"
  },
  "c11-s031": {
    "text": "我七点吃早饭。",
    "source": "/api/practice-recording?file=36ea068556fa0af811e912cbe5e1fc5b5862c31515b3f4075bbcc77df47404c3",
    "sha256": "bc8b998d750ae55986410b70a6f9da488713354104ae819a5ea6b45d2016d5c0",
    "pinyin": "Wǒ qī diǎn chī zǎofàn."
  },
  "c11-s032": {
    "text": "一张床",
    "source": "/api/practice-recording?file=fd1fe7e44dc950531a6c233270c5487a226503cc0e7c7465f14f16488f5c10b6",
    "sha256": "92616a4af4a9afb0920e496363cc60aaeaa616b989fb0c7a7ce23882649650f2",
    "pinyin": "yì zhāng chuáng"
  },
  "c11-s033": {
    "text": "一张纸",
    "source": "/course08/audio/c08-t63.mp3",
    "sha256": "246989b4e14e5e9e29c7d1d507003f1733630ca8d36a7525351c058bf10b3f35",
    "pinyin": "yì zhāng zhǐ"
  },
  "c11-s034": {
    "text": "一张地图",
    "source": "/api/practice-recording?file=4b78d0488850f843aae6c89cb11731a86df2feca4aa4c2fe8258b0ca42733651",
    "sha256": "758724c9d62e427471192651f2e2656b8e15b9412bf77190b3db9a413df577ff",
    "pinyin": "yì zhāng dìtú"
  },
  "c11-s035": {
    "text": "一张桌子",
    "source": "/api/practice-recording?file=9580162337cc6962002b192053601fbf133a59d4692719afc32992944c9dd280",
    "sha256": "93dcad206e1ddf2cd20e25f118961c8b5b4d66a1b8396ae189e917f336deaa52",
    "pinyin": "yì zhāng zhuōzi"
  },
  "c11-s036": {
    "text": "一张菜单",
    "source": "/api/practice-recording?file=c3a09407c32a90f29411cad756089d2c2191b41033b22dc6726988ed9926d3ef",
    "sha256": "de5ef31b0b87f72e46a4c34034e7c375572decf5c452871e3a86a03100a7a38e",
    "pinyin": "yì zhāng càidān"
  },
  "c11-s037": {
    "text": "请开门。",
    "source": "/audio/hsk1-097-sentence.mp3",
    "sha256": "2e0550acd68a5ff440fee65770fa2c2736c0a42a2ff526c32c3e3a3870a5901a",
    "pinyin": "Qǐng kāi mén."
  },
  "c11-s038": {
    "text": "请开灯。",
    "source": "/api/practice-recording?file=f178a913e6189dcb2c45eaaa60f9d67abd2e70ceadb2b117426886e81a38fd8e",
    "sha256": "a35a740effa3748df17ee586d4816ce14925aaa78d645efd91984ab90c12f5e2",
    "pinyin": "Qǐng kāi dēng."
  },
  "c11-s039": {
    "text": "请等一下。",
    "source": "/api/practice-recording?file=e470cbdfef736596ed2467773595005a963d52dc9cfa984ebaba62e7e0b6b886",
    "sha256": "42d49d4760bb45a26899cb877b73ea541cedeeee4af50da76444076a9ef94f46",
    "pinyin": "Qǐng děng yíxià."
  },
  "c11-s040": {
    "text": "这家店很受欢迎。",
    "source": "/api/practice-recording?file=a449fa9a74249163b0659493e9e7726c231764016a376d6ca38782c4facdec46",
    "sha256": "10e40718f772fc0437bb79a04236dcc6d366d368ecddd354f2d1ebe65900acad",
    "pinyin": "Zhè jiā diàn hěn shòu huānyíng."
  },
  "c11-s041": {
    "text": "我常常走路来学校。",
    "source": "/api/practice-recording?file=394f3823acae428431bca50421544f84f7a8a7e8481edd6519198aa5b5b130c6",
    "sha256": "65871e12afa13cb505de8dc691438a77f05345af0314b5c9785cd536cbe7c3b4",
    "pinyin": "Wǒ chángcháng zǒulù lái xuéxiào."
  },
  "c11-s042": {
    "text": "我有时候坐地铁。",
    "source": "/api/practice-recording?file=b8653bdf5152fd69fa148b51b39a52f3135b3ce726397b23f9963db91c76345e",
    "sha256": "ac7dff8cea0d3af25df626d424696b8d84cce198714cdb499efe1b830809bd35",
    "pinyin": "Wǒ yǒu shíhou zuò dìtiě."
  },
  "c11-s043": {
    "text": "我很少打的。",
    "source": "/api/practice-recording?file=85f3c1ef8f01f3f1d16689ae49783e4de858fd88dabda2a59032b5b0ebabaac2",
    "sha256": "a09274af3d05c05fed206d66166713801cdf81409d024d172276cd7d973c1238",
    "pinyin": "Wǒ hěn shǎo dǎ dī."
  },
  "c11-s044": {
    "text": "我从不骑马来学校。",
    "source": "/api/practice-recording?file=565232655aff6cf68690bc34e39860476b18e73c33943a989cb917a3e2cd4752",
    "sha256": "867f98b320155fc5d431e6031d16f56aec6d1b0422bcc3a2b4e74775a8f5b711",
    "pinyin": "Wǒ cóng bù qí mǎ lái xuéxiào."
  },
  "c11-s045": {
    "text": "我一直在等你。",
    "source": "/api/practice-recording?file=ab763ea068d06467f92c211f29c3f985c290fdff9e7a25494fcdd57c446f3b4e",
    "sha256": "52b14ecb0d1830d848045a13e80711b16576801180889f5b728adc896a97360b",
    "pinyin": "Wǒ yìzhí zài děng nǐ."
  },
  "c11-s046": {
    "text": "我什么时候可以来？",
    "source": "/api/practice-recording?file=3ee8827278afb7b682bf71a49ff30b1c1d8085283dc43af9263212273c3f0d01",
    "sha256": "7d542ce8459c6aa7aa86d109fe6777e9e3871ad4968af88885f29846b2a8b1ce",
    "pinyin": "Wǒ shénme shíhou kěyǐ lái?"
  },
  "c11-s047": {
    "text": "你任何时候都可以来。",
    "source": "/api/practice-recording?file=41ad3516949c3b9b78c0c9d1404774d1f9c0478dc2a508f69cda6cc333aa9287",
    "sha256": "b91b1a113f8640bf4dcb9441ea93fb46e13b408f060ac6214c2d71f2e3ba2efe",
    "pinyin": "Nǐ rènhé shíhou dōu kěyǐ lái."
  },
  "c11-s048": {
    "text": "吃苹果对身体好。",
    "source": "/api/practice-recording?file=fa29acbebfe10cac5e13373125849775a69877fb7d0a5dfd2503d5619c129bae",
    "sha256": "439f8f2f977b3318f8eb5df9c3f456100caa8590bd5f5b828b4d9ae800bd4251",
    "pinyin": "Chī píngguǒ duì shēntǐ hǎo."
  },
  "c11-s049": {
    "text": "不吃早饭对身体不好。",
    "source": "/api/practice-recording?file=557ad33d5c263d6c40bfbcef13e7ba557592041be4849de09407503e501357ed",
    "sha256": "c8a3f30f57c618f96ec95d834d64cef2b43702cb3e16daaa506bc3600ed3e067",
    "pinyin": "Bù chī zǎofàn duì shēntǐ bù hǎo."
  },
  "c11-s050": {
    "text": "三十加二十等于五十。",
    "source": "/api/practice-recording?file=d66b84a356a752239016362b09815c5d658b2263ed113eb325e8d26747b8b0b3",
    "sha256": "bc06e21bed097304ef9b5f5b688c30feb3b4ca7172df5b4d584e5884d0f09131",
    "pinyin": "Sānshí jiā èrshí děngyú wǔshí."
  },
  "c11-s051": {
    "text": "一共七十二元。",
    "source": "/api/practice-recording?file=3fe5c6e3f3f3f2bef9e54239c8b5fdeb9e8107cdc869f3a9a3c77e5efd7728c6",
    "sha256": "8dd3e1967fe50e92cee76e19fd3237fb03c464c14b7e4cfffe2a54a16852cf3e",
    "pinyin": "Yígòng qīshí'èr yuán."
  },
  "c11-s052": {
    "text": "他们是收银员。",
    "source": "/api/practice-recording?file=b97cc59cb65902784ce3ce439f892ef0e490cd7579f9d903fdcef3930b908643",
    "sha256": "465580a366ebf1f678bf5f3a2cf1ba8caf130dde85eb75ce3818a2c406c66cfe",
    "pinyin": "Tāmen shì shōuyínyuán."
  },
  "c11-s053": {
    "text": "我们今天上课。",
    "source": "/api/practice-recording?file=0c32d0acf6bedbbfa73c3334202fc9d495c082381770233565b361a87940c959",
    "sha256": "42cbc073267a79c9f5660a71e1f07e20cebf77357fe93cecf0611fccc2322fab",
    "pinyin": "Wǒmen jīntiān shàngkè."
  }
}
