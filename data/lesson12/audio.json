  },
  "c12-s001": {
    "text": "我有一套公寓。",
    "source": "/api/lesson12-asset?file=audio-5342b0b22dc4b6046e1a7559393f1d567bfba1d7c5e1a19a2c07bac80df5c74b",
    "path": "resources/lesson12/audio/5342b0b22dc4b6046e1a7559393f1d567bfba1d7c5e1a19a2c07bac80df5c74b.mp3",
    "sha256": "525746cd881b6d4ce99b6f6dd7022ecca57800ee5244c62c20c3d78ceacbe3bf",
    "bytes": 11520,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s002": {
    "text": "我的公寓里有两个卧室。",
    "source": "/api/lesson12-asset?file=audio-9f455088874ba6174a7ddcf0c42f13e87937188942ba6b74d09dcb49588bb107",
    "path": "resources/lesson12/audio/9f455088874ba6174a7ddcf0c42f13e87937188942ba6b74d09dcb49588bb107.mp3",
    "sha256": "9f02ac994e6d61c4e6ead7e7260c2e7f4f6bbe7c5f7c757e5c2c2ed9a95aed4e",
    "bytes": 18000,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s003": {
    "text": "还有一个厨房、一个卫生间和一个客厅。",
    "source": "/api/lesson12-asset?file=audio-22b018ee85124f1273a1cac8de22ea2c65fe95b6acb849d6514620dfe6067927",
    "path": "resources/lesson12/audio/22b018ee85124f1273a1cac8de22ea2c65fe95b6acb849d6514620dfe6067927.mp3",
    "sha256": "0a7d2ac4489ed9efcef2b7a0337f6b539b81b571d68dc660096d09374f89a308",
    "bytes": 26208,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s004": {
    "text": "我的房间里有一张床、一张桌子和两把椅子。",
    "source": "/api/lesson12-asset?file=audio-a2b5ad639c9a12278029fbe94274a107167766c1098afb0491f455dd04c2d284",
    "path": "resources/lesson12/audio/a2b5ad639c9a12278029fbe94274a107167766c1098afb0491f455dd04c2d284.mp3",
    "sha256": "dce287c8ae5e2b323601ef3ee22b0bd57e4a3d432843e032979108fa7c159b77",
    "bytes": 30960,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s005": {
    "text": "你想租房吗？",
    "source": "/api/lesson12-asset?file=audio-bd23bcb4d5ee74291a06d92832d94af7afb0d1400f7f05ba6dbd17ec2b47b328",
    "path": "resources/lesson12/audio/bd23bcb4d5ee74291a06d92832d94af7afb0d1400f7f05ba6dbd17ec2b47b328.mp3",
    "sha256": "4a024681b1752550beb11bfa8f91922c203e02132bd15662f741c910320b670f",
    "bytes": 11232,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s006": {
    "text": "我要租房，不是租车。",
    "source": "/api/lesson12-asset?file=audio-ad9ac270b78aa34631a5c9924f95c1bbf6ff15ba43fe9d3898932b4b95eb0a85",
    "path": "resources/lesson12/audio/ad9ac270b78aa34631a5c9924f95c1bbf6ff15ba43fe9d3898932b4b95eb0a85.mp3",
    "sha256": "8918c0d150d44c117ce29cd90ada7069687d0c5cbf33c27a148c9751f0141d62",
    "bytes": 16848,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s007": {
    "text": "我想坐出租车。",
    "source": "/api/lesson12-asset?file=audio-fa8365456f8cd15c161d776745d9346a85d050c7d7508ab40d8e856ff3e1cd14",
    "path": "resources/lesson12/audio/fa8365456f8cd15c161d776745d9346a85d050c7d7508ab40d8e856ff3e1cd14.mp3",
    "sha256": "68a3a52d9571ecec703fd7c5c621c25b6baaf21fb8904e0e606d087fdbc07fca",
    "bytes": 12672,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s008": {
    "text": "你在干什么？",
    "source": "/api/lesson12-asset?file=audio-57e359abe5ad370a457fcdc5b38e102ca2c5e80fdb06dcaeb2b89b944aea3ba8",
    "path": "resources/lesson12/audio/57e359abe5ad370a457fcdc5b38e102ca2c5e80fdb06dcaeb2b89b944aea3ba8.mp3",
    "sha256": "589a7f9041e6916554bf2b954db2c4e01ba02ba46fae4f2bfa9a7449db4cdb84",
    "bytes": 11232,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s009": {
    "text": "先考驾驶证，再开车。",
    "source": "/api/lesson12-asset?file=audio-2ea50de6cd35f7455f002cc97ca34fa06e5588b85d12cf3bc656b5c66ba940d8",
    "path": "resources/lesson12/audio/2ea50de6cd35f7455f002cc97ca34fa06e5588b85d12cf3bc656b5c66ba940d8.mp3",
    "sha256": "9034d4ad8295130cedac726484af801973bd9baf6559c50ac2952b2bd9d634be",
    "bytes": 18288,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s010": {
    "text": "我六点半起床。",
    "source": "/api/lesson12-asset?file=audio-0542b6404419045b05ca9085d3126650a272c9288da20bbb7ff90ccadde96a30",
    "path": "resources/lesson12/audio/0542b6404419045b05ca9085d3126650a272c9288da20bbb7ff90ccadde96a30.mp3",
    "sha256": "3606196d7dbc7eafb27937a2806fa4e6eb0d9eda75f2b03080b403cb6988e531",
    "bytes": 12960,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s011": {
    "text": "六点五十吃早饭。",
    "source": "/api/lesson12-asset?file=audio-07838894c99d51810c821a1cd878a4b67cf881563f8977f7260524319bd5c432",
    "path": "resources/lesson12/audio/07838894c99d51810c821a1cd878a4b67cf881563f8977f7260524319bd5c432.mp3",
    "sha256": "f1390749bec038fb8c0a5fccf8f28ec8b9ee05d87152a131d9c0c94120e875f5",
    "bytes": 14256,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s012": {
    "text": "七点半来学校。",
    "source": "/api/lesson12-asset?file=audio-8a8390850168817e603fdeb0e6c274163f8948388f65c1d1db97c3fb4bd1ed75",
    "path": "resources/lesson12/audio/8a8390850168817e603fdeb0e6c274163f8948388f65c1d1db97c3fb4bd1ed75.mp3",
    "sha256": "b5f6ba21cf23fecd92e968f5d7c84ad632b6b5aecac524dff25f9b4571ba2952",
    "bytes": 13248,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s013": {
    "text": "八点四十上课。",
    "source": "/api/lesson12-asset?file=audio-04eec5bd008c64672c1b6e0e06a39963604be0aee6900dd8c1e45bd7d09ec198",
    "path": "resources/lesson12/audio/04eec5bd008c64672c1b6e0e06a39963604be0aee6900dd8c1e45bd7d09ec198.mp3",
    "sha256": "bfeb2244bda4c20cd779ac2894081f2a39bc2928a6f1d7a6b3e26ee05879c330",
    "bytes": 12960,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s014": {
    "text": "十二点下课。",
    "source": "/api/lesson12-asset?file=audio-66022a2d772039afc1ca843fbe22692aba0a6ab8ee17afc3f5ec68a8f89dd1fa",
    "path": "resources/lesson12/audio/66022a2d772039afc1ca843fbe22692aba0a6ab8ee17afc3f5ec68a8f89dd1fa.mp3",
    "sha256": "0b19ebae28dab5990107e945046c6f2e3b79a78ed0b341b66b18b3b4e152e500",
    "bytes": 12096,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s015": {
    "text": "十二点一刻吃午饭。",
    "source": "/api/lesson12-asset?file=audio-fdc91e921de3f28da1b8108efb01cc6ab035299cfc8f1b3efaacdd9c70b1b683",
    "path": "resources/lesson12/audio/fdc91e921de3f28da1b8108efb01cc6ab035299cfc8f1b3efaacdd9c70b1b683.mp3",
    "sha256": "a653e1aa2c1538a97c767d3ff92465f1ded784debd7bcf5a7b56b0e2e82f2819",
    "bytes": 15408,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s016": {
    "text": "下午我也有课。",
    "source": "/api/lesson12-asset?file=audio-3ef95545ddf139bad86fb762a83432056166935ec8eaca143281267e80ffccec",
    "path": "resources/lesson12/audio/3ef95545ddf139bad86fb762a83432056166935ec8eaca143281267e80ffccec.mp3",
    "sha256": "bfb5870d28734558ea63243fe78308a8cfd888e020ca9e7f728226c6eb46a9d1",
    "bytes": 12672,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s017": {
    "text": "下课后我做作业。",
    "source": "/api/lesson12-asset?file=audio-b1d9f6a318aaa7730fb64d5daa21d6e81c01ff3db2065d14e668eb6c39f9cbcb",
    "path": "resources/lesson12/audio/b1d9f6a318aaa7730fb64d5daa21d6e81c01ff3db2065d14e668eb6c39f9cbcb.mp3",
    "sha256": "d33168c35576f38ef40765d04c36eecda7eb6d8a77cc28da7ca51d14ca253e32",
    "bytes": 14688,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s018": {
    "text": "晚上六点我坐地铁回家。",
    "source": "/api/lesson12-asset?file=audio-a5b4170013ccab7d6c42a6643ba1f4eb6da37adb34d626e73307a3a54ce952e3",
    "path": "resources/lesson12/audio/a5b4170013ccab7d6c42a6643ba1f4eb6da37adb34d626e73307a3a54ce952e3.mp3",
    "sha256": "8e2b7704fe923094dec7e38d12b62316a30c3aecae26042437d04ff1049f9e14",
    "bytes": 19152,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s019": {
    "text": "回家后我吃晚饭，复习汉语。",
    "source": "/api/lesson12-asset?file=audio-afc94fcd82114bc87b7e3e2a2a900635c7846a4f4f835f323a65c4f1e9eb88c6",
    "path": "resources/lesson12/audio/afc94fcd82114bc87b7e3e2a2a900635c7846a4f4f835f323a65c4f1e9eb88c6.mp3",
    "sha256": "ee545c4a58c5d086e5a4b0e1a3ab111015d9810e1e8c488f4155998708dcfbd2",
    "bytes": 21168,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s020": {
    "text": "我大概晚上十一点睡觉。",
    "source": "/api/lesson12-asset?file=audio-d0906960d7ae3bf31394cea186b952dc59ee3d0675e7e7b2e200c51b990dac7b",
    "path": "resources/lesson12/audio/d0906960d7ae3bf31394cea186b952dc59ee3d0675e7e7b2e200c51b990dac7b.mp3",
    "sha256": "99994d3bf35b029b75c703cb8a223f5844e438c8e7e7f0148d4bc390d9f8d85d",
    "bytes": 17280,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s021": {
    "text": "请问，银行在哪儿？",
    "source": "/api/lesson12-asset?file=audio-c90b259f080c90c1f81bb941bf707c18914c5a485850f8911a2993ecfe83b39c",
    "path": "resources/lesson12/audio/c90b259f080c90c1f81bb941bf707c18914c5a485850f8911a2993ecfe83b39c.mp3",
    "sha256": "6b7e6611309c55fe357910fb04b24f20b5819713c6d951f65a48b869c372b2c9",
    "bytes": 14832,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s022": {
    "text": "银行在书店东边。",
    "source": "/api/lesson12-asset?file=audio-a6c12aec0414f869e472b656ca2a188e21e92bf0b3b3c652b95ed025adeff924",
    "path": "resources/lesson12/audio/a6c12aec0414f869e472b656ca2a188e21e92bf0b3b3c652b95ed025adeff924.mp3",
    "sha256": "754ea37d411c6e0c97b920a6bd8582d2c357c90bec369738560e1a1c06342836",
    "bytes": 14832,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s023": {
    "text": "这是什么地方？",
    "source": "/api/lesson12-asset?file=audio-52ff121914ebefe55ae73eef47047d79c9de352af39fecd71df61c4926d9e708",
    "path": "resources/lesson12/audio/52ff121914ebefe55ae73eef47047d79c9de352af39fecd71df61c4926d9e708.mp3",
    "sha256": "17a29ffab2cc16fed4b7d149fb9d0c093f1ac3062bf2c53bf7fe1eec51e79c32",
    "bytes": 11808,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s024": {
    "text": "哪座楼是银行？",
    "source": "/api/lesson12-asset?file=audio-249959473930f0f76e4b00abd6ed6098c378e8f2d4e735559d8ceb4bd96ae73f",
    "path": "resources/lesson12/audio/249959473930f0f76e4b00abd6ed6098c378e8f2d4e735559d8ceb4bd96ae73f.mp3",
    "sha256": "2b7b5d4ec5f2fcc9d741b2a05c7ed040411d6fecad57d774fb77d2797ee004d0",
    "bytes": 12960,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s025": {
    "text": "宿舍楼都在北边。",
    "source": "/api/lesson12-asset?file=audio-ffad7f99aaa23a8364d58eb4729cd906c491dae984c350011b4930652a1fb475",
    "path": "resources/lesson12/audio/ffad7f99aaa23a8364d58eb4729cd906c491dae984c350011b4930652a1fb475.mp3",
    "sha256": "11418075e3b0728d89784080476e00c8ab5d3761e56c119f511cdbc2a07d20f0",
    "bytes": 14832,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s026": {
    "text": "一号楼、二号楼在前边，三号楼、四号楼在后边。",
    "source": "/api/lesson12-asset?file=audio-22bafa70641a3923fb11141274fef079d26ceaac484a2574ac93a37151854e81",
    "path": "resources/lesson12/audio/22bafa70641a3923fb11141274fef079d26ceaac484a2574ac93a37151854e81.mp3",
    "sha256": "41e454c63a694da4335ff5a1df6d67f7b8e4806d3f2d26bb0be8ba6abec661ea",
    "bytes": 33408,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s027": {
    "text": "我的宿舍在四号楼。",
    "source": "/api/lesson12-asset?file=audio-08923fca76962201b8bc5cdaad4ac7db83af14583d4119c13f4b8c3e940f4a81",
    "path": "resources/lesson12/audio/08923fca76962201b8bc5cdaad4ac7db83af14583d4119c13f4b8c3e940f4a81.mp3",
    "sha256": "66deab651b995fa3b25f54bc21a3b33043f0e84ae3f2148f49b59974b2855000",
    "bytes": 15120,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s028": {
    "text": "一直往前走。",
    "source": "/api/lesson12-asset?file=audio-18ddb78ddc4349e340ecb59ba072a1a5b143bcbe99b63c010f3ca3387f515dbe",
    "path": "resources/lesson12/audio/18ddb78ddc4349e340ecb59ba072a1a5b143bcbe99b63c010f3ca3387f515dbe.mp3",
    "sha256": "e03bdc3626873f6124a7f0aa297b26a60ce9cf25f6cb86452fcbcf3ddc6caeb6",
    "bytes": 11952,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s029": {
    "text": "到路口往左转。",
    "source": "/api/lesson12-asset?file=audio-07edac0c33e56e17c1744cecd477c85540ac6fc6d03371c6ab5cad74524e6034",
    "path": "resources/lesson12/audio/07edac0c33e56e17c1744cecd477c85540ac6fc6d03371c6ab5cad74524e6034.mp3",
    "sha256": "bf73041a7af3a6319dd203287a3bf18168392767a719a29e0fa19790f8c820c1",
    "bytes": 13392,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s030": {
    "text": "书店在银行西边。",
    "source": "/api/lesson12-asset?file=audio-f172bd7e56cdacc277c19266f08c2296e5a358375bc42bea110b2e3ac2dccca2",
    "path": "resources/lesson12/audio/f172bd7e56cdacc277c19266f08c2296e5a358375bc42bea110b2e3ac2dccca2.mp3",
    "sha256": "aeed834dffb8017644cb2cd08ab1c05a2156c9d3170def283053dabfbdd82007",
    "bytes": 14976,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s031": {
    "text": "今天下雨，我用雨伞。",
    "source": "/api/lesson12-asset?file=audio-1063a43f9be012e16802682db4d419cc098d16e14e8ea97b913042e316d9d0d7",
    "path": "resources/lesson12/audio/1063a43f9be012e16802682db4d419cc098d16e14e8ea97b913042e316d9d0d7.mp3",
    "sha256": "1517a2ef59683f4472619f2ea3cdbabb9412b80e9b61f43dfcc92ce337dbf18b",
    "bytes": 16992,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s032": {
    "text": "我点了外卖。",
    "source": "/api/lesson12-asset?file=audio-bd9216ac46104d18b1efe073246becd64e918b2b6c8b3de12967a0891023b678",
    "path": "resources/lesson12/audio/bd9216ac46104d18b1efe073246becd64e918b2b6c8b3de12967a0891023b678.mp3",
    "sha256": "ee9662d6d6c009431f3bccd09b52235698695e95541c52732c4f55de08274da8",
    "bytes": 11232,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s033": {
    "text": "请找我十块钱。",
    "source": "/api/lesson12-asset?file=audio-70b6ea42b6067d6ffd07f45b0e3ea380abb9916ecfe574d8e2ee4a0eda958b3b",
    "path": "resources/lesson12/audio/70b6ea42b6067d6ffd07f45b0e3ea380abb9916ecfe574d8e2ee4a0eda958b3b.mp3",
    "sha256": "bbd1efe5f70a2c445282d524e64436556f1a91ead512e01450b75444625db941",
    "bytes": 12528,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s034": {
    "text": "你很勇敢！",
    "source": "/api/lesson12-asset?file=audio-93fbf4d5638c3001c46f0cd271b942bfe98132f1ff9b7a2f9c867de4cc97de08",
    "path": "resources/lesson12/audio/93fbf4d5638c3001c46f0cd271b942bfe98132f1ff9b7a2f9c867de4cc97de08.mp3",
    "sha256": "63ea52b084347b151211338f92c4deb000e23b542db6e221e545315d755150cf",
    "bytes": 11232,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s035": {
    "text": "这是我们学校。",
    "source": "/api/lesson12-asset?file=audio-c5ef5bf061483b8d2f3b7d6629ad8ef41096069d2bb60f668974ca398c830471",
    "path": "resources/lesson12/audio/c5ef5bf061483b8d2f3b7d6629ad8ef41096069d2bb60f668974ca398c830471.mp3",
    "sha256": "d5bfbe4690122a90a985edbd4c405224c4038ac51373958186f3cbd4e7acc195",
    "bytes": 12096,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s036": {
    "text": "东边的那座楼是银行。",
    "source": "/api/lesson12-asset?file=audio-85b73848f134d8ff355b83b32bbea4dc539be5b5ff6c5dcc1084ac64474d6f8e",
    "path": "resources/lesson12/audio/85b73848f134d8ff355b83b32bbea4dc539be5b5ff6c5dcc1084ac64474d6f8e.mp3",
    "sha256": "0fa89c7663dbe8daf47ed3a2869738f0c2b0949c151b969e7ccfff7b2f0f9223",
    "bytes": 16560,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s037": {
    "text": "不用。",
    "source": "/api/lesson12-asset?file=audio-5087ad6f55241dba290ea318b74ab52d08e41498efcf5a07da2df56969ca8106",
    "path": "resources/lesson12/audio/5087ad6f55241dba290ea318b74ab52d08e41498efcf5a07da2df56969ca8106.mp3",
    "sha256": "88f984b9fd8b5e319eb630e75a6984c5096bb63fffc0fe1a6b3e746d6137da77",
    "bytes": 11232,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s038": {
    "text": "你在干嘛？",
    "source": "/api/lesson12-asset?file=audio-c5331bc5672198119bd07864897bc8b55993d64d90089b33b13e592b21db5782",
    "path": "resources/lesson12/audio/c5331bc5672198119bd07864897bc8b55993d64d90089b33b13e592b21db5782.mp3",
    "sha256": "4e7c183d0b0d31468f4b88a29f14db3cbc29d674541966115af06c4bd11036ac",
    "bytes": 9936,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s039": {
    "text": "今天天气不好。",
    "source": "/api/lesson12-asset?file=audio-ada4a44477a6e707ad3f91551ad8260d46654debd9923e7944c5a6faf6728491",
    "path": "resources/lesson12/audio/ada4a44477a6e707ad3f91551ad8260d46654debd9923e7944c5a6faf6728491.mp3",
    "sha256": "2e679b73939dd7202d1a65b2321883ac71596f96081b7d72734309071189af94",
    "bytes": 12672,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  },
  "c12-s040": {
    "text": "我不用出租车。",
    "source": "/api/lesson12-asset?file=audio-70e524f63c0f7ca59e7f15d35b1aacf9ee16a2dbdd83a6a194dd0eb992b8b1eb",
    "path": "resources/lesson12/audio/70e524f63c0f7ca59e7f15d35b1aacf9ee16a2dbdd83a6a194dd0eb992b8b1eb.mp3",
    "sha256": "b63c38ec2f7d396b49db41b62fda7b3726ae059417cb4f556a7ab1a808d1da07",
    "bytes": 12096,
    "voice": "zh-CN-XiaoxiaoNeural",
    "rate": "-10%",
    "synthetic": true
  }
}
