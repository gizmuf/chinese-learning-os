    {
      "id": "request",
      "title": {
        "en": "A small request",
        "fr": "Une petite demande",
        "ru": "Небольшая просьба",
        "tr": "Küçük bir rica"
      },
      "lesson": 6,
      "note": {
        "en": "Keep 你能给我…吗 as one request frame. Swap the thing you need; 吗 stays at the end.",
