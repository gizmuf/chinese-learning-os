  "topics": [
    {
      "id": "ref-move-p01",
      "title": "Six movement pairs",
      "explanation": "The first part tells the spatial path. 来 is toward the visible speaker; 去 is away. Moving the speaker changes the ending even when the actor follows the same screen path.",
      "sourcePages": [
        1
      ],
      "termIds": [
        "ref-move-t001",
        "ref-move-t002",
        "ref-move-t003",
        "ref-move-t004",
        "ref-move-t005",
        "ref-move-t006",
        "ref-move-t007",
        "ref-move-t008",
        "ref-move-t009",
        "ref-move-t010",
        "ref-move-t011",
        "ref-move-t012",
        "ref-move-t013",
        "ref-move-t014"
      ],
      "exampleIds": [],
      "visualIntent": "Distinct room entry, exit, bridge/over, return-home, upstairs and downstairs scenes. Actor path stays fixed while the speaker changes start/end."
    },
    {
      "id": "ref-move-p02",
      "title": "Movement and completed phrases",
      "explanation": "走 can mean walk or leave; 走路 explicitly means walking on foot. 到 highlights reaching a destination. 了 often signals completion or a change of state; it is not a universal English past tense.",
      "sourcePages": [
        2
      ],
      "termIds": [
        "ref-move-t015",
        "ref-move-t002",
        "ref-move-t001",
        "ref-move-t016",
        "ref-move-t017",
        "ref-move-t018",
        "ref-move-t019",
        "ref-move-t020",
        "ref-move-t021",
        "ref-move-t022",
        "ref-move-t023"
      ],
      "exampleIds": [],
      "visualIntent": "Walk along a route, leave a start, reach a destination, return to the reference place; completion is a distinct endpoint state."
    },
    {
      "id": "ref-move-p03",
      "title": "A route and real sentences",
      "explanation": "The route fixes a visible viewpoint. Entering/exiting labels do not become universal: change the speaker in Six movement pairs to compare. Recall the four English cues before checking their Chinese.",
      "sourcePages": [
        3
      ],
      "termIds": [
        "ref-move-t024",
        "ref-move-t018",
        "ref-move-t016",
        "ref-move-t004",
        "ref-move-t005",
        "ref-move-t017"
      ],
      "exampleIds": [
        "ref-move-e001",
        "ref-move-e002",
        "ref-move-e003",
        "ref-move-e004",
        "ref-move-e005",
        "ref-move-e006",
        "ref-move-e007"
      ],
      "visualIntent": "Home → walk → arrival → enter → exit → return, with a home-based speaker. Speaking and recall retain full sentence context."
    }
  ],
